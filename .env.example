# Mode simulasi GPS (hanya untuk development/testing, default false)
# Aktifkan agar bisa menguji drag timer tanpa kendaraan di dev mode.
VITE_DEV_GPS_SIMULATION=true

# Supabase (auth + admin approval)
# Isi dengan nilai dari dashboard Supabase (Settings > API).
# Anon key bersifat public dan aman untuk dipakai di frontend.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
